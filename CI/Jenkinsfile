pipeline {
    agent { label 'docker' } // Testcontainers (Postgres/Redis) needs a Docker-capable agent

    tools {
        jdk 'jdk-25'
        nodejs 'node-20'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    triggers {
        pollSCM('H/5 * * * *') // or drop this in favor of a GitHub webhook
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Back-end: build & test') {
            steps {
                dir('socialnetwork-api') {
                    withMaven(jdk: 'jdk-25', maven: 'apache-maven-3.9.3') {
                        sh 'mvn -B -ntp clean verify'
                    }
                }
            }
            post {
                always {
                    junit 'socialnetwork-api/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Front-end: install & lint') {
            steps {
                dir('socialnetwork-web') {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Front-end: build') {
            steps {
                dir('socialnetwork-web') {
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'socialnetwork-api/target/*.jar, socialnetwork-web/dist/**', allowEmptyArchive: true
            cleanWs()
        }
        failure {
            echo 'Build failed — wire up Slack/email notification here if desired.'
        }
    }
}
